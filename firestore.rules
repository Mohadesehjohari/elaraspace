rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function mine(uid) { return signed() && request.auth.uid == uid; }
    function p(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function n(username) { return /databases/$(database)/documents/usernames/$(username); }
    function adminPath(uid) { return /databases/$(database)/documents/admins/$(uid); }
    function requestPath(from, to) {
      return /databases/$(database)/documents/friendRequests/$(from + '_' + to);
    }
    function blockPath(owner, target) {
      return /databases/$(database)/documents/blocks/$(owner + '__' + target);
    }
    function mutePath(owner, target) {
      return /databases/$(database)/documents/socialMutes/$(owner + '__' + target);
    }
    function blockedBetween(a, b) {
      return signed() && a != b && (
        exists(blockPath(a, b)) ||
        exists(blockPath(b, a))
      );
    }
    function isAdmin() {
      return signed()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.enabled == true
        && get(adminPath(request.auth.uid)).data.role in ['owner','admin','moderator'];
    }
    function isOwner() {
      return signed()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.enabled == true
        && get(adminPath(request.auth.uid)).data.role == 'owner';
    }
    function isPublisher() {
      return signed()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.enabled == true
        && get(adminPath(request.auth.uid)).data.role in ['owner','admin'];
    }
    function friendOf(owner) {
      return signed() && !blockedBetween(request.auth.uid, owner) && (
        (exists(requestPath(request.auth.uid, owner)) &&
         get(requestPath(request.auth.uid, owner)).data.status == 'accepted') ||
        (exists(requestPath(owner, request.auth.uid)) &&
         get(requestPath(owner, request.auth.uid)).data.status == 'accepted')
      );
    }
    function requestParticipant(owner) {
      return signed() && !blockedBetween(request.auth.uid, owner) && (
        exists(requestPath(request.auth.uid, owner)) ||
        exists(requestPath(owner, request.auth.uid))
      );
    }
    function profilePublic(data) {
      return !data.keys().hasAny(['profilePublic']) || data.profilePublic == true;
    }
    function groupPath(id) { return /databases/$(database)/documents/groups/$(id); }
    function groupMemberPath(id, memberId) { return /databases/$(database)/documents/groups/$(id)/groupMembers/$(memberId); }
    function groupInvitePath(id, memberId) { return /databases/$(database)/documents/groups/$(id)/groupInvites/$(memberId); }
    function isGroupMember(id) { return signed() && exists(groupMemberPath(id, request.auth.uid)); }
    function isGroupOwner(id) { return signed() && exists(groupPath(id)) && get(groupPath(id)).data.owner == request.auth.uid; }
    function clubPath(id) { return /databases/$(database)/documents/clubs/$(id); }
    function clubMemberPath(id, memberId) { return /databases/$(database)/documents/clubs/$(id)/clubMembers/$(memberId); }
    function clubInvitePath(id, memberId) { return /databases/$(database)/documents/clubs/$(id)/clubInvites/$(memberId); }
    function clubJoinRequestPath(id, memberId) { return /databases/$(database)/documents/clubs/$(id)/clubJoinRequests/$(memberId); }
    function clubBanPath(id, memberId) { return /databases/$(database)/documents/clubs/$(id)/clubBans/$(memberId); }
    function isClubMember(id) { return signed() && exists(clubMemberPath(id, request.auth.uid)); }
    function isClubOwner(id) { return signed() && exists(clubPath(id)) && get(clubPath(id)).data.owner == request.auth.uid; }
    function collabPath(id) { return /databases/$(database)/documents/collabSpaces/$(id); }
    function collabMemberPath(id, memberId) { return /databases/$(database)/documents/collabSpaces/$(id)/members/$(memberId); }
    function collabInvitePath(id, memberId) { return /databases/$(database)/documents/collabInvites/$(id + '__' + memberId); }
    function collabLinkPath(token) { return /databases/$(database)/documents/collabLinks/$(token); }
    function challengeRatePath(uid) { return /databases/$(database)/documents/challengeRateLimits/$(uid); }
    function isCollabMember(id) { return signed() && exists(collabMemberPath(id, request.auth.uid)); }
    function isCollabOwner(id) { return signed() && exists(collabPath(id)) && get(collabPath(id)).data.ownerUid == request.auth.uid; }
    function validCollabKind(kind) { return kind in ['task','habit','goal','language-class','leitner-word']; }
    function verifiedAccount() { return signed() && request.auth.token.email_verified == true; }
    function accountLinkPath(id) { return /databases/$(database)/documents/accountLinks/$(id); }
    function trustedDeliveryPath(spaceId,uid) { return /databases/$(database)/documents/trustedDeliveries/$(spaceId + '__' + uid); }
    function trustedAccountLinkActive(linkId,from,to) {
      return verifiedAccount() && from != to
        && exists(accountLinkPath(linkId))
        && get(accountLinkPath(linkId)).data.status == 'active'
        && (get(accountLinkPath(linkId)).data.uidA == from || get(accountLinkPath(linkId)).data.uidB == from)
        && (get(accountLinkPath(linkId)).data.uidA == to || get(accountLinkPath(linkId)).data.uidB == to)
        && !blockedBetween(from,to);
    }
    function isClubManager(id) {
      return signed() && exists(clubPath(id)) && (
        get(clubPath(id)).data.owner == request.auth.uid ||
        get(clubPath(id)).data.assistant1 == request.auth.uid ||
        get(clubPath(id)).data.assistant2 == request.auth.uid
      );
    }
    function canCreateClub() {
      return signed() && (
        isOwner() ||
        (exists(p(request.auth.uid)) && get(p(request.auth.uid)).data.xp >= 350)
      );
    }
    function activityPath(id) { return /databases/$(database)/documents/activities/$(id); }
    function postPath(id) { return /databases/$(database)/documents/socialPosts/$(id); }
    function storyPath(id) { return /databases/$(database)/documents/socialStories/$(id); }
    function canReadActivity(id) {
      return signed() && exists(activityPath(id)) && (
        get(activityPath(id)).data.uid == request.auth.uid ||
        (
          !blockedBetween(request.auth.uid, get(activityPath(id)).data.uid) &&
          (
            get(activityPath(id)).data.visibility == 'public' ||
            (get(activityPath(id)).data.visibility == 'friends' && friendOf(get(activityPath(id)).data.uid))
          )
        )
      );
    }
    function canReadPost(id) {
      return signed() && exists(postPath(id)) && (
        get(postPath(id)).data.uid == request.auth.uid ||
        (
          !blockedBetween(request.auth.uid, get(postPath(id)).data.uid) &&
          (
            get(postPath(id)).data.visibility == 'public' ||
            (get(postPath(id)).data.visibility == 'friends' && friendOf(get(postPath(id)).data.uid))
          )
        )
      );
    }
    function canReadStory(id) {
      return signed() && exists(storyPath(id)) && (
        get(storyPath(id)).data.uid == request.auth.uid ||
        (
          !blockedBetween(request.auth.uid, get(storyPath(id)).data.uid) &&
          get(storyPath(id)).data.expiresAt > request.time &&
          (
            get(storyPath(id)).data.visibility == 'public' ||
            (get(storyPath(id)).data.visibility == 'friends' && friendOf(get(storyPath(id)).data.uid))
          )
        )
      );
    }
    function validProfile(data) {
      return data.keys().hasOnly(['username','name','bio','xp','profilePublic'])
        && data.keys().hasAll(['username','name','bio','xp'])
        && data.username is string
        && data.username.matches('^[a-z][a-z0-9_]{2,19}$')
        && data.name is string && data.name.size() <= 60
        && data.bio is string && data.bio.size() <= 300
        && data.xp is int && data.xp >= 0 && data.xp <= 9999999
        && (!data.keys().hasAny(['profilePublic']) || data.profilePublic is bool);
    }

    match /admins/{uid} {
      allow get: if mine(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /publicSettings/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['maintenanceEnabled','maintenanceMessage','updatedAt','updatedBy'])
        && request.resource.data.maintenanceEnabled is bool
        && request.resource.data.maintenanceMessage is string
        && request.resource.data.maintenanceMessage.size() <= 240
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isOwner();
    }

    match /adminSettings/{documentId} {
      allow read, create, update: if isAdmin();
      allow delete: if isOwner();
    }

    match /adminAudit/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','role','action','target','meta','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['owner','admin','moderator']
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 80
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 160;
      allow update, delete: if false;
    }

    match /blogArticles/{articleId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isPublisher()
        && request.resource.data.keys().hasOnly(['title','excerpt','body','category','locale','status','coverUrl','readMinutes','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.keys().hasAll(['title','excerpt','body','category','locale','status','coverUrl','readMinutes','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 160
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() >= 2 && request.resource.data.excerpt.size() <= 500
        && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 12000
        && request.resource.data.category in ['planning','focus','habits','reading','wellbeing','productivity']
        && request.resource.data.locale in ['fa','en']
        && request.resource.data.status in ['draft','published']
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 1000
        && request.resource.data.readMinutes is int && request.resource.data.readMinutes >= 1 && request.resource.data.readMinutes <= 60
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isPublisher()
        && request.resource.data.keys().hasOnly(['title','excerpt','body','category','locale','status','coverUrl','readMinutes','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 160
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() >= 2 && request.resource.data.excerpt.size() <= 500
        && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 12000
        && request.resource.data.category in ['planning','focus','habits','reading','wellbeing','productivity']
        && request.resource.data.locale in ['fa','en']
        && request.resource.data.status in ['draft','published']
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 1000
        && request.resource.data.readMinutes is int && request.resource.data.readMinutes >= 1 && request.resource.data.readMinutes <= 60
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isPublisher();
    }

    match /sitePages/{pageId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isPublisher()
        && pageId.matches('^[a-z0-9][a-z0-9-]{1,79}$')
        && request.resource.data.keys().hasOnly(['slug','title','excerpt','body','locale','status','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.keys().hasAll(['slug','title','excerpt','body','locale','status','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.slug == pageId
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 160
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() >= 2 && request.resource.data.excerpt.size() <= 500
        && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 16000
        && request.resource.data.locale in ['fa','en']
        && request.resource.data.status in ['draft','published']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isPublisher()
        && request.resource.data.keys().hasOnly(['slug','title','excerpt','body','locale','status','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.slug == pageId
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 160
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() >= 2 && request.resource.data.excerpt.size() <= 500
        && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 16000
        && request.resource.data.locale in ['fa','en']
        && request.resource.data.status in ['draft','published']
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isPublisher();
    }

    match /usernames/{username} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed() && username.matches('^[a-z][a-z0-9_]{2,19}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(p(request.auth.uid))
        && getAfter(p(request.auth.uid)).data.username == username
        && (
          !exists(p(request.auth.uid)) ||
          get(p(request.auth.uid)).data.username != username
        );
      allow update: if false;
      allow delete: if signed()
        && resource.data.uid == request.auth.uid
        && existsAfter(p(request.auth.uid))
        && getAfter(p(request.auth.uid)).data.username != username;
    }

    match /socialStats/{uid} {
      allow get: if mine(uid) || isAdmin() || (
        signed() && !blockedBetween(request.auth.uid, uid) && (
          resource.data.visibility == 'public' ||
          (resource.data.visibility == 'friends' && friendOf(uid))
        )
      );
      allow list: if false;
      allow create, update: if mine(uid)
        && request.resource.data.keys().hasOnly(['streak','visibility','updatedAt'])
        && request.resource.data.keys().hasAll(['streak','visibility','updatedAt'])
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 36500
        && request.resource.data.visibility in ['private','friends','public']
        && request.resource.data.updatedAt == request.time;
      allow delete: if mine(uid);
    }

    match /profiles/{uid} {
      allow get: if mine(uid) || isAdmin() || (
        signed() && !blockedBetween(request.auth.uid, uid) && (
          profilePublic(resource.data) ||
          friendOf(uid) ||
          requestParticipant(uid)
        )
      );
      allow list: if isAdmin();
      allow create: if mine(uid)
        && validProfile(request.resource.data)
        && request.resource.data.bio == ''
        && request.resource.data.xp == 0
        && getAfter(n(request.resource.data.username)).data.uid == uid;
      allow update: if mine(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','name','bio','username','profilePublic'])
        && existsAfter(n(request.resource.data.username))
        && getAfter(n(request.resource.data.username)).data.uid == uid
        && (
          request.resource.data.username == resource.data.username ||
          (
            !exists(n(resource.data.username)) ||
            get(n(resource.data.username)).data.uid != uid ||
            !existsAfter(n(resource.data.username))
          )
        );
      allow delete: if false;
    }

    match /private/{uid}/app/{documentId} {
      allow read: if mine(uid) && documentId == 'main';
      allow create, update: if mine(uid) && documentId == 'main'
        && request.resource.data.keys().hasOnly(['payload','updatedAt'])
        && request.resource.data.payload is map;
      allow delete: if false;
    }

    match /presence/{uid} {
      allow get: if mine(uid) || (
        signed() && !blockedBetween(request.auth.uid, uid) && (
          resource.data.visibility == 'public' ||
          (resource.data.visibility == 'friends' && friendOf(uid))
        )
      );
      allow list: if false;
      allow create, update: if mine(uid)
        && request.resource.data.keys().hasOnly(['uid','visibility','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visibility in ['private','friends','public']
        && request.resource.data.updatedAt == request.time;
      allow delete: if mine(uid);
    }

    match /socialMutes/{muteId} {
      allow get, list: if signed() && resource.data.owner == request.auth.uid;
      allow create: if signed()
        && muteId == request.auth.uid + '__' + request.resource.data.target
        && request.resource.data.keys().hasOnly(['owner','target','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && exists(p(request.resource.data.target))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signed() && resource.data.owner == request.auth.uid;
    }

    match /socialContextMutes/{muteId} {
      allow get, list: if signed() && resource.data.owner == request.auth.uid;
      allow create: if signed()
        && muteId == request.auth.uid + '__' + request.resource.data.context + '__' + request.resource.data.contextId
        && request.resource.data.keys().hasOnly(['owner','context','contextId','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.context in ['group','club']
        && request.resource.data.contextId is string
        && request.resource.data.contextId.size() > 0 && request.resource.data.contextId.size() <= 160
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signed() && resource.data.owner == request.auth.uid;
    }

    match /socialReports/{reportId} {
      allow get: if signed() && (resource.data.reporter == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['reporter','target','context','contextId','reason','createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && request.resource.data.context in ['profile','friend-request','dm','group','challenge','club','page','activity']
        && request.resource.data.contextId is string
        && request.resource.data.contextId.size() <= 160
        && request.resource.data.reason in ['spam','harassment','hate','sexual','violence','privacy','other']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow get, list: if signed() && resource.data.owner == request.auth.uid;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['owner','target','targetName','targetUsername','createdAt'])
        && request.resource.data.keys().hasAll(['owner','target','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && blockId == request.auth.uid + '__' + request.resource.data.target
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() <= 60
        && request.resource.data.targetUsername is string
        && request.resource.data.targetUsername.size() <= 20
        && exists(p(request.resource.data.target))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signed() && resource.data.owner == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow get, list: if signed()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['from','to','status'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && exists(p(request.resource.data.to))
        && !blockedBetween(request.resource.data.from, request.resource.data.to)
        && !exists(requestPath(request.resource.data.to, request.resource.data.from));
      allow update: if signed()
        && !blockedBetween(resource.data.from, resource.data.to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (
            resource.data.to == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.status in ['accepted','declined']
          ) ||
          (
            resource.data.from == request.auth.uid &&
            resource.data.status == 'declined' &&
            request.resource.data.status == 'pending'
          )
        );
      allow delete: if signed() && (
        ((resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) &&
          resource.data.status == 'pending') ||
        ((resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) &&
          resource.data.status in ['accepted','declined'])
      );
    }

    match /conversations/{conversationId} {
      allow get, list: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['kind','members','createdBy','createdAt','updatedAt','lastText','lastSender'])
        && request.resource.data.kind == 'dm'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastText == ''
        && request.resource.data.lastSender == ''
        && friendOf(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]);
      allow update: if signed()
        && request.auth.uid in resource.data.members
        && !blockedBetween(resource.data.members[0], resource.data.members[1])
        && request.resource.data.members == resource.data.members
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','lastSender','updatedAt'])
        && request.resource.data.lastSender == request.auth.uid
        && request.resource.data.lastText is string
        && request.resource.data.lastText.size() <= 280
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signed()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if signed()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && !blockedBetween(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members[1]
          )
          && request.resource.data.keys().hasOnly(['sender','text','createdAt'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.lastText == '' ||
            request.time >= get(/databases/$(database)/documents/conversations/$(conversationId)).data.updatedAt + duration.value(500, 'ms')
          );
        allow update: if false;
        allow delete: if signed()
          && resource.data.sender == request.auth.uid;
      }

      match /reads/{readerUid} {
        allow get: if signed()
          && readerUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow list: if false;
        allow create, update: if signed()
          && readerUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.keys().hasOnly(['uid','lastReadAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.lastReadAt == request.time;
        allow delete: if signed() && readerUid == request.auth.uid;
      }
    }

    match /groups/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list: if false;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['owner','title','status','createdAt','updatedAt','lastText','lastSender'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastText == ''
        && request.resource.data.lastSender == '';
      allow update: if signed()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['owner','title','status','createdAt','updatedAt','lastText','lastSender'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.status in ['active','closed']
        && request.resource.data.updatedAt == request.time
        && (
          (
            isGroupMember(groupId)
            && resource.data.status == 'active'
            && request.resource.data.status == resource.data.status
            && request.resource.data.title == resource.data.title
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','lastSender','updatedAt'])
            && request.resource.data.lastSender == request.auth.uid
            && request.resource.data.lastText is string
            && request.resource.data.lastText.size() <= 280
          ) ||
          (
            isGroupOwner(groupId)
            && request.resource.data.lastText == resource.data.lastText
            && request.resource.data.lastSender == resource.data.lastSender
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','status','updatedAt'])
            && !(resource.data.status == 'closed' && request.resource.data.status == 'active')
          )
        );
      allow delete: if false;

      match /groupMembers/{memberId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if signed()
          && request.resource.data.keys().hasOnly(['uid','role','joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.joinedAt == request.time
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(groupPath(groupId)).data.owner == request.auth.uid
            ) ||
            (
              getAfter(groupPath(groupId)).data.owner == request.auth.uid
              && getAfter(groupPath(groupId)).data.status == 'active'
              && request.resource.data.role == 'member'
              && friendOf(memberId)
            ) ||
            (
              memberId == request.auth.uid
              && request.resource.data.role == 'member'
              && existsAfter(groupInvitePath(groupId, memberId))
              && getAfter(groupInvitePath(groupId, memberId)).data.to == request.auth.uid
              && getAfter(groupInvitePath(groupId, memberId)).data.status == 'accepted'
            )
          );
        allow update: if false;
        allow delete: if signed() && (
          (memberId == request.auth.uid && resource.data.role == 'member') ||
          (isGroupOwner(groupId) && memberId != request.auth.uid)
        );
      }

      match /groupInvites/{inviteId} {
        allow get, list: if signed() && (resource.data.to == request.auth.uid || isGroupOwner(groupId));
        allow create: if isGroupOwner(groupId)
          && get(groupPath(groupId)).data.status == 'active'
          && inviteId == request.resource.data.to
          && request.resource.data.keys().hasOnly(['from','to','status','createdAt','updatedAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && friendOf(request.resource.data.to);
        allow update: if signed()
          && request.resource.data.from == resource.data.from
          && request.resource.data.to == resource.data.to
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (
              resource.data.to == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status in ['accepted','declined']
            ) ||
            (
              isGroupOwner(groupId)
              && resource.data.status == 'declined'
              && request.resource.data.status == 'pending'
            )
          );
        allow delete: if signed() && (resource.data.to == request.auth.uid || isGroupOwner(groupId));
      }

      match /reads/{readerUid} {
        allow get: if signed() && readerUid == request.auth.uid && isGroupMember(groupId);
        allow list: if false;
        allow create, update: if signed()
          && readerUid == request.auth.uid
          && isGroupMember(groupId)
          && request.resource.data.keys().hasOnly(['uid','lastReadAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.lastReadAt == request.time;
        allow delete: if signed() && readerUid == request.auth.uid;
      }

      match /messages/{messageId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && get(groupPath(groupId)).data.status == 'active'
          && request.resource.data.keys().hasOnly(['sender','text','createdAt'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (
            get(groupPath(groupId)).data.lastText == '' ||
            request.time >= get(groupPath(groupId)).data.updatedAt + duration.value(500, 'ms')
          );
        allow update: if false;
        allow delete: if signed() && (
          resource.data.sender == request.auth.uid || isGroupOwner(groupId)
        );
      }
    }

    match /{path=**}/groupMembers/{memberId} {
      allow get, list: if signed() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/groupInvites/{inviteId} {
      allow get, list: if signed() && resource.data.to == request.auth.uid;
    }


    match /clubs/{clubId} {
      allow get: if signed() && (resource.data.visibility == 'public' || isClubMember(clubId));
      allow list: if signed() && resource.data.visibility == 'public';
      allow create: if canCreateClub()
        && request.resource.data.keys().hasOnly(['owner','title','kind','visibility','membershipMode','assistant1','assistant2','restDay','bio','rulesText','language','avatarPath','bannerPath','memberLimit','memberCount','lastMembershipUid','lastMembershipAction','currentBookTitle','status','createdAt','updatedAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.kind in ['reading','fitness','language','focus','habits','meditation','general']
        && request.resource.data.visibility in ['private','public']
        && request.resource.data.membershipMode in ['public','request','invite']
        && request.resource.data.assistant1 == ''
        && request.resource.data.assistant2 == ''
        && request.resource.data.restDay is int
        && request.resource.data.restDay >= 0 && request.resource.data.restDay <= 6
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 600
        && request.resource.data.rulesText is string && request.resource.data.rulesText.size() <= 1200
        && request.resource.data.language is string && request.resource.data.language.size() <= 16
        && request.resource.data.avatarPath == ''
        && request.resource.data.bannerPath == ''
        && request.resource.data.memberLimit is int && request.resource.data.memberLimit >= 2 && request.resource.data.memberLimit <= 200
        && request.resource.data.memberCount == 1
        && request.resource.data.lastMembershipUid == request.auth.uid
        && request.resource.data.lastMembershipAction == 'create'
        && request.resource.data.currentBookTitle == ''
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signed()
        && request.resource.data.keys().hasOnly(['owner','title','kind','visibility','membershipMode','assistant1','assistant2','restDay','bio','rulesText','language','avatarPath','bannerPath','memberLimit','memberCount','lastMembershipUid','lastMembershipAction','currentBookTitle','status','createdAt','updatedAt'])
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.visibility in ['private','public']
        && request.resource.data.membershipMode in ['public','request','invite']
        && request.resource.data.restDay is int && request.resource.data.restDay >= 0 && request.resource.data.restDay <= 6
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 600
        && request.resource.data.rulesText is string && request.resource.data.rulesText.size() <= 1200
        && request.resource.data.language is string && request.resource.data.language.size() <= 16
        && request.resource.data.avatarPath is string && request.resource.data.avatarPath.size() <= 300
        && request.resource.data.bannerPath is string && request.resource.data.bannerPath.size() <= 300
        && request.resource.data.memberLimit is int && request.resource.data.memberLimit >= request.resource.data.memberCount && request.resource.data.memberLimit <= 200
        && request.resource.data.memberCount is int && request.resource.data.memberCount >= 1 && request.resource.data.memberCount <= request.resource.data.memberLimit
        && request.resource.data.currentBookTitle is string && request.resource.data.currentBookTitle.size() <= 120
        && request.resource.data.status in ['active','closed']
        && request.resource.data.updatedAt == request.time
        && (
          (
            isClubOwner(clubId)
            && request.resource.data.owner == resource.data.owner
            && request.resource.data.memberCount == resource.data.memberCount
            && request.resource.data.lastMembershipUid == resource.data.lastMembershipUid
            && request.resource.data.lastMembershipAction == resource.data.lastMembershipAction
            && request.resource.data.assistant1 == resource.data.assistant1
            && request.resource.data.assistant2 == resource.data.assistant2
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','visibility','membershipMode','restDay','bio','rulesText','language','avatarPath','bannerPath','memberLimit','currentBookTitle','status','updatedAt'])
            && !(resource.data.status == 'closed' && request.resource.data.status == 'active')
          ) ||
          (
            isClubOwner(clubId)
            && request.resource.data.owner == resource.data.owner
            && request.resource.data.memberCount == resource.data.memberCount
            && request.resource.data.lastMembershipUid == resource.data.lastMembershipUid
            && request.resource.data.lastMembershipAction == resource.data.lastMembershipAction
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assistant1','assistant2','updatedAt'])
            && request.resource.data.assistant1 is string
            && request.resource.data.assistant2 is string
            && request.resource.data.assistant1 != request.auth.uid
            && request.resource.data.assistant2 != request.auth.uid
            && (request.resource.data.assistant1 == '' || request.resource.data.assistant2 == '' || request.resource.data.assistant1 != request.resource.data.assistant2)
            && (request.resource.data.assistant1 == '' || (existsAfter(clubMemberPath(clubId, request.resource.data.assistant1)) && getAfter(clubMemberPath(clubId, request.resource.data.assistant1)).data.role == 'assistant'))
            && (request.resource.data.assistant2 == '' || (existsAfter(clubMemberPath(clubId, request.resource.data.assistant2)) && getAfter(clubMemberPath(clubId, request.resource.data.assistant2)).data.role == 'assistant'))
          ) ||
          (
            request.resource.data.owner == resource.data.owner
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && request.resource.data.lastMembershipAction == 'join'
            && request.resource.data.lastMembershipUid is string
            && !exists(clubMemberPath(clubId, request.resource.data.lastMembershipUid))
            && existsAfter(clubMemberPath(clubId, request.resource.data.lastMembershipUid))
            && getAfter(clubMemberPath(clubId, request.resource.data.lastMembershipUid)).data.role == 'member'
            && request.resource.data.assistant1 == resource.data.assistant1
            && request.resource.data.assistant2 == resource.data.assistant2
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','lastMembershipUid','lastMembershipAction','updatedAt'])
            && (
              (
                request.resource.data.lastMembershipUid == request.auth.uid
                && (
                  resource.data.membershipMode == 'public' ||
                  (existsAfter(clubInvitePath(clubId, request.auth.uid)) && getAfter(clubInvitePath(clubId, request.auth.uid)).data.status == 'accepted') ||
                  (existsAfter(clubJoinRequestPath(clubId, request.auth.uid)) && getAfter(clubJoinRequestPath(clubId, request.auth.uid)).data.status == 'accepted')
                )
              ) ||
              (
                isClubManager(clubId)
                && existsAfter(clubJoinRequestPath(clubId, request.resource.data.lastMembershipUid))
                && getAfter(clubJoinRequestPath(clubId, request.resource.data.lastMembershipUid)).data.status == 'accepted'
              )
            )
            && !exists(clubBanPath(clubId, request.resource.data.lastMembershipUid))
          ) ||
          (
            request.resource.data.owner == resource.data.owner
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && request.resource.data.lastMembershipUid is string
            && request.resource.data.lastMembershipAction in ['leave','kick','ban']
            && exists(clubMemberPath(clubId, request.resource.data.lastMembershipUid))
            && !existsAfter(clubMemberPath(clubId, request.resource.data.lastMembershipUid))
            && request.resource.data.lastMembershipUid != resource.data.owner
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','lastMembershipUid','lastMembershipAction','assistant1','assistant2','updatedAt'])
            && request.resource.data.assistant1 != request.resource.data.lastMembershipUid
            && request.resource.data.assistant2 != request.resource.data.lastMembershipUid
            && (
              (request.resource.data.lastMembershipAction == 'leave' && request.resource.data.lastMembershipUid == request.auth.uid) ||
              (request.resource.data.lastMembershipAction in ['kick','ban'] && isClubOwner(clubId))
            )
          ) ||
          (
            isClubOwner(clubId)
            && request.resource.data.owner != resource.data.owner
            && request.resource.data.owner is string
            && request.resource.data.memberCount == resource.data.memberCount
            && request.resource.data.lastMembershipUid == resource.data.lastMembershipUid
            && request.resource.data.lastMembershipAction == resource.data.lastMembershipAction
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner','assistant1','assistant2','updatedAt'])
            && existsAfter(clubMemberPath(clubId, request.resource.data.owner))
            && getAfter(clubMemberPath(clubId, request.resource.data.owner)).data.role == 'owner'
            && existsAfter(clubMemberPath(clubId, resource.data.owner))
            && getAfter(clubMemberPath(clubId, resource.data.owner)).data.role == 'member'
            && request.resource.data.assistant1 != request.resource.data.owner
            && request.resource.data.assistant2 != request.resource.data.owner
          )
        );
      allow delete: if false;

      match /clubMembers/{memberId} {
        allow get, list: if isClubMember(clubId);
        allow create: if signed()
          && request.resource.data.keys().hasOnly(['uid','role','joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.joinedAt == request.time
          && !exists(clubBanPath(clubId, memberId))
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(clubPath(clubId)).data.owner == request.auth.uid
              && getAfter(clubPath(clubId)).data.memberCount == 1
            ) ||
            (
              request.resource.data.role == 'member'
              && getAfter(clubPath(clubId)).data.lastMembershipUid == memberId
              && getAfter(clubPath(clubId)).data.lastMembershipAction == 'join'
              && getAfter(clubPath(clubId)).data.memberCount == get(clubPath(clubId)).data.memberCount + 1
              && (
                (
                  memberId == request.auth.uid
                  && (
                    get(clubPath(clubId)).data.membershipMode == 'public' ||
                    (existsAfter(clubInvitePath(clubId, memberId)) && getAfter(clubInvitePath(clubId, memberId)).data.status == 'accepted') ||
                    (existsAfter(clubJoinRequestPath(clubId, memberId)) && getAfter(clubJoinRequestPath(clubId, memberId)).data.status == 'accepted')
                  )
                ) ||
                (
                  isClubManager(clubId)
                  && existsAfter(clubJoinRequestPath(clubId, memberId))
                  && getAfter(clubJoinRequestPath(clubId, memberId)).data.status == 'accepted'
                )
              )
            )
          );
        allow update: if signed()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && (
            (
              isClubOwner(clubId)
              && resource.data.role in ['member','assistant']
              && request.resource.data.role in ['member','assistant']
              && (
                (request.resource.data.role == 'assistant' && (getAfter(clubPath(clubId)).data.assistant1 == memberId || getAfter(clubPath(clubId)).data.assistant2 == memberId)) ||
                (request.resource.data.role == 'member' && getAfter(clubPath(clubId)).data.assistant1 != memberId && getAfter(clubPath(clubId)).data.assistant2 != memberId)
              )
            ) ||
            (
              isClubOwner(clubId)
              && request.resource.data.role == 'owner'
              && getAfter(clubPath(clubId)).data.owner == memberId
            ) ||
            (
              memberId == request.auth.uid
              && resource.data.role == 'owner'
              && request.resource.data.role == 'member'
              && getAfter(clubPath(clubId)).data.owner != request.auth.uid
            )
          );
        allow delete: if signed()
          && getAfter(clubPath(clubId)).data.memberCount == get(clubPath(clubId)).data.memberCount - 1
          && getAfter(clubPath(clubId)).data.lastMembershipUid == memberId
          && (
            (memberId == request.auth.uid && resource.data.role != 'owner' && getAfter(clubPath(clubId)).data.lastMembershipAction == 'leave') ||
            (isClubOwner(clubId) && memberId != request.auth.uid && getAfter(clubPath(clubId)).data.lastMembershipAction in ['kick','ban'])
          );
      }

      match /clubInvites/{inviteId} {
        allow get, list: if signed() && (resource.data.to == request.auth.uid || isClubManager(clubId));
        allow create: if isClubManager(clubId)
          && get(clubPath(clubId)).data.status == 'active'
          && inviteId == request.resource.data.to
          && request.resource.data.keys().hasOnly(['from','to','status','createdAt','updatedAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && friendOf(request.resource.data.to)
          && !exists(clubBanPath(clubId, request.resource.data.to));
        allow update: if signed()
          && request.resource.data.from == resource.data.from
          && request.resource.data.to == resource.data.to
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (
              resource.data.to == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status in ['accepted','declined']
              && (
                request.resource.data.status == 'declined' ||
                (
                  existsAfter(clubMemberPath(clubId, request.auth.uid))
                  && getAfter(clubPath(clubId)).data.memberCount == get(clubPath(clubId)).data.memberCount + 1
                )
              )
            ) ||
            (
              isClubManager(clubId)
              && resource.data.status == 'declined'
              && request.resource.data.status == 'pending'
            )
          );
        allow delete: if signed() && (resource.data.to == request.auth.uid || isClubManager(clubId));
      }

      match /clubJoinRequests/{requesterUid} {
        allow get, list: if signed() && (requesterUid == request.auth.uid || isClubManager(clubId));
        allow create: if signed()
          && requesterUid == request.auth.uid
          && get(clubPath(clubId)).data.status == 'active'
          && get(clubPath(clubId)).data.membershipMode == 'request'
          && !exists(clubBanPath(clubId, requesterUid))
          && request.resource.data.keys().hasOnly(['uid','status','createdAt','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signed()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (
              isClubManager(clubId)
              && resource.data.status == 'pending'
              && request.resource.data.status in ['accepted','declined']
              && (
                request.resource.data.status == 'declined' ||
                (
                  existsAfter(clubMemberPath(clubId, requesterUid))
                  && getAfter(clubPath(clubId)).data.memberCount == get(clubPath(clubId)).data.memberCount + 1
                )
              )
            ) ||
            (
              requesterUid == request.auth.uid
              && resource.data.status == 'declined'
              && request.resource.data.status == 'pending'
            )
          );
        allow delete: if signed() && (requesterUid == request.auth.uid || isClubManager(clubId));
      }

      match /clubBans/{memberId} {
        allow get, list: if isClubOwner(clubId);
        allow create: if isClubOwner(clubId)
          && memberId != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','by','createdAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(clubMemberPath(clubId, memberId))
          && !existsAfter(clubMemberPath(clubId, memberId))
          && getAfter(clubPath(clubId)).data.lastMembershipUid == memberId
          && getAfter(clubPath(clubId)).data.lastMembershipAction == 'ban';
        allow update: if false;
        allow delete: if isClubOwner(clubId);
      }

      match /clubPosts/{postId} {
        allow get, list: if isClubMember(clubId);
        allow create: if isClubManager(clubId)
          && get(clubPath(clubId)).data.status == 'active'
          && request.resource.data.keys().hasOnly(['uid','kind','domain','title','body','cadence','options','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['mission','challenge','poll','reminder','result','congratulations','notice']
          && request.resource.data.domain == get(clubPath(clubId)).data.kind
          && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
          && request.resource.data.body is string && request.resource.data.body.size() <= 1200
          && request.resource.data.cadence in ['none','daily','weekly','monthly']
          && request.resource.data.options is list && request.resource.data.options.size() <= 6
          && (
            (request.resource.data.kind == 'poll' && request.resource.data.options.size() >= 2) ||
            (request.resource.data.kind != 'poll' && request.resource.data.options.size() == 0)
          )
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isClubManager(clubId);

        match /votes/{voteId} {
          allow get, list: if isClubMember(clubId);
          allow create: if isClubMember(clubId)
            && voteId == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid','option','createdAt'])
            && request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/clubs/$(clubId)/clubPosts/$(postId)).data.kind == 'poll'
            && request.resource.data.option in get(/databases/$(database)/documents/clubs/$(clubId)/clubPosts/$(postId)).data.options
            && request.resource.data.createdAt == request.time;
          allow update: if isClubMember(clubId)
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['option'])
            && request.resource.data.option in get(/databases/$(database)/documents/clubs/$(clubId)/clubPosts/$(postId)).data.options;
          allow delete: if signed() && resource.data.uid == request.auth.uid;
        }
      }
    }


    match /{path=**}/clubMembers/{memberId} {
      allow get, list: if signed() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/clubInvites/{inviteId} {
      allow get, list: if signed() && resource.data.to == request.auth.uid;
    }

    match /{path=**}/clubJoinRequests/{requesterUid} {
      allow get, list: if signed() && resource.data.uid == request.auth.uid;
    }


    // Trusted account linking: mutual, one-time opt-in. A link alone
    // never exposes a private item or creates membership.
    match /accountLinks/{linkId} {
      allow get, list: if signed()
        && (resource.data.uidA == request.auth.uid || resource.data.uidB == request.auth.uid);
      allow create: if verifiedAccount()
        && request.resource.data.keys().hasOnly(['uidA','uidB','participants','requestedBy','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uidA','uidB','participants','requestedBy','status','createdAt','updatedAt'])
        && request.resource.data.uidA is string && request.resource.data.uidB is string
        && request.resource.data.uidA != request.resource.data.uidB
        && linkId == request.resource.data.uidA + '__' + request.resource.data.uidB
        && request.resource.data.participants == [request.resource.data.uidA,request.resource.data.uidB]
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && friendOf(request.auth.uid == request.resource.data.uidA ? request.resource.data.uidB : request.resource.data.uidA)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if verifiedAccount()
        && request.auth.uid in resource.data.participants
        && request.resource.data.uidA == resource.data.uidA
        && request.resource.data.uidB == resource.data.uidB
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','requestedBy','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.requestedBy == resource.data.requestedBy
            && request.auth.uid != resource.data.requestedBy
            && !blockedBetween(resource.data.uidA,resource.data.uidB)
          ) ||
          (
            resource.data.status in ['pending','active']
            && request.resource.data.status == 'revoked'
            && request.resource.data.requestedBy == resource.data.requestedBy
          ) ||
          (
            resource.data.status == 'revoked'
            && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid
            && friendOf(request.auth.uid == resource.data.uidA ? resource.data.uidB : resource.data.uidA)
          )
        );
      allow delete: if false;
    }

    // Sender makes an EXPLICIT per-item share once. Only the named recipient
    // can subsequently materialize its own membership; no per-item consent UI.
    match /trustedDeliveries/{deliveryId} {
      allow get, list: if signed() && (
        resource.data.to == request.auth.uid || resource.data.from == request.auth.uid
      );
      allow create: if verifiedAccount()
        && request.resource.data.keys().hasOnly(['spaceId','from','to','kind','linkId','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['spaceId','from','to','kind','linkId','createdAt','updatedAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && deliveryId == request.resource.data.spaceId + '__' + request.resource.data.to
        && isCollabOwner(request.resource.data.spaceId)
        && request.resource.data.kind == get(collabPath(request.resource.data.spaceId)).data.kind
        && trustedAccountLinkActive(request.resource.data.linkId,request.resource.data.from,request.resource.data.to)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if verifiedAccount()
        && resource.data.from == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkId','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && trustedAccountLinkActive(request.resource.data.linkId,resource.data.from,resource.data.to);
      allow delete: if signed() && resource.data.from == request.auth.uid;
    }

    match /collabSpaces/{spaceId} {
      allow get: if isCollabMember(spaceId);
      allow list: if false;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['ownerUid','kind','title','payloadJson','visibility','createdAt','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && validCollabKind(request.resource.data.kind)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() > 1
        && request.resource.data.payloadJson.size() <= 12000
        && request.resource.data.visibility == 'private'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isCollabOwner(spaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['ownerUid','kind','title','payloadJson','visibility','createdAt','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() > 1
        && request.resource.data.payloadJson.size() <= 12000
        && request.resource.data.visibility == 'private'
        && request.resource.data.updatedAt == request.time;
      allow delete: if isCollabOwner(spaceId);

      match /members/{memberId} {
        allow get: if signed() && (memberId == request.auth.uid || isCollabMember(spaceId));
        allow list: if isCollabMember(spaceId);
        allow create: if signed()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['owner','member']
          && request.resource.data.localEntityId is string
          && request.resource.data.localEntityId.size() <= 120
          && request.resource.data.progressCompleted is int
          && request.resource.data.progressCompleted >= 0
          && request.resource.data.progressTotal is int
          && request.resource.data.progressTotal >= 1
          && request.resource.data.progressTotal <= 1000000
          && request.resource.data.progressCompleted <= request.resource.data.progressTotal
          && request.resource.data.progressPercent is int
          && request.resource.data.progressPercent >= 0
          && request.resource.data.progressPercent <= 100
          && request.resource.data.joinedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            (
              request.resource.data.role == 'owner'
              && get(collabPath(spaceId)).data.ownerUid == request.auth.uid
              && request.resource.data.keys().hasOnly(['uid','role','localEntityId','progressCompleted','progressTotal','progressPercent','joinedAt','updatedAt'])
            ) ||
            (
              request.resource.data.role == 'member'
              && request.resource.data.keys().hasOnly(['uid','role','localEntityId','progressCompleted','progressTotal','progressPercent','joinedAt','updatedAt'])
              && existsAfter(collabInvitePath(spaceId, memberId))
              && getAfter(collabInvitePath(spaceId, memberId)).data.to == request.auth.uid
              && getAfter(collabInvitePath(spaceId, memberId)).data.spaceId == spaceId
              && getAfter(collabInvitePath(spaceId, memberId)).data.status == 'accepted'
            ) ||
            (
              request.resource.data.role == 'member'
              && request.resource.data.keys().hasOnly(['uid','role','joinToken','localEntityId','progressCompleted','progressTotal','progressPercent','joinedAt','updatedAt'])
              && request.resource.data.joinToken is string
              && request.resource.data.joinToken.size() >= 20
              && request.resource.data.joinToken.size() <= 80
              && exists(collabLinkPath(request.resource.data.joinToken))
              && get(collabLinkPath(request.resource.data.joinToken)).data.active == true
              && get(collabLinkPath(request.resource.data.joinToken)).data.spaceId == spaceId
            ) ||
            (
              request.resource.data.role == 'member'
              && request.resource.data.keys().hasOnly(['uid','role','trustedLinkId','localEntityId','progressCompleted','progressTotal','progressPercent','joinedAt','updatedAt'])
              && request.resource.data.trustedLinkId is string
              && exists(trustedDeliveryPath(spaceId,memberId))
              && get(trustedDeliveryPath(spaceId,memberId)).data.to == request.auth.uid
              && get(trustedDeliveryPath(spaceId,memberId)).data.spaceId == spaceId
              && get(trustedDeliveryPath(spaceId,memberId)).data.kind == get(collabPath(spaceId)).data.kind
              && get(trustedDeliveryPath(spaceId,memberId)).data.from == get(collabPath(spaceId)).data.ownerUid
              && request.resource.data.trustedLinkId == get(trustedDeliveryPath(spaceId,memberId)).data.linkId
              && trustedAccountLinkActive(request.resource.data.trustedLinkId,get(trustedDeliveryPath(spaceId,memberId)).data.from,request.auth.uid)
            )
          );
        allow update: if signed()
          && memberId == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['localEntityId','progressCompleted','progressTotal','progressPercent','updatedAt'])
          && request.resource.data.localEntityId is string
          && request.resource.data.localEntityId.size() <= 120
          && request.resource.data.progressCompleted is int
          && request.resource.data.progressCompleted >= 0
          && request.resource.data.progressTotal is int
          && request.resource.data.progressTotal >= 1
          && request.resource.data.progressTotal <= 1000000
          && request.resource.data.progressCompleted <= request.resource.data.progressTotal
          && request.resource.data.progressPercent is int
          && request.resource.data.progressPercent >= 0
          && request.resource.data.progressPercent <= 100
          && request.resource.data.updatedAt == request.time;
        allow delete: if signed() && (memberId == request.auth.uid || isCollabOwner(spaceId));
      }
    }

    match /collabInvites/{inviteId} {
      allow get, list: if signed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['spaceId','from','to','kind','title','status','createdAt','updatedAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && friendOf(request.resource.data.to)
        && request.resource.data.spaceId is string
        && request.resource.data.spaceId.size() > 0
        && request.resource.data.spaceId.size() <= 120
        && inviteId == request.resource.data.spaceId + '__' + request.resource.data.to
        && isCollabOwner(request.resource.data.spaceId)
        && validCollabKind(request.resource.data.kind)
        && request.resource.data.kind == get(collabPath(request.resource.data.spaceId)).data.kind
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signed()
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.title == resource.data.title
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.to == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted','declined']
          ) ||
          (
            resource.data.from == request.auth.uid
            && isCollabOwner(resource.data.spaceId)
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending'
          )
        );
      allow delete: if signed() && resource.data.from == request.auth.uid && resource.data.status == 'pending';
    }

    match /collabLinks/{token} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed()
        && token.size() >= 20
        && token.size() <= 80
        && request.resource.data.keys().hasOnly(['spaceId','ownerUid','kind','title','active','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.spaceId is string
        && isCollabOwner(request.resource.data.spaceId)
        && request.resource.data.kind == get(collabPath(request.resource.data.spaceId)).data.kind
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      allow update: if signed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.title == resource.data.title
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if signed() && resource.data.ownerUid == request.auth.uid;
    }

    match /challengeRateLimits/{uid} {
      allow get: if mine(uid);
      allow list: if false;
      allow create: if mine(uid)
        && request.resource.data.keys().hasOnly(['uid','lastAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastAt == request.time;
      allow update: if mine(uid)
        && request.resource.data.keys().hasOnly(['uid','lastAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.lastAt == request.time
        && request.time >= resource.data.lastAt + duration.value(10, 's');
      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow get, list: if signed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['from','to','status','targetKind','targetText','targetValue','mode','attempt','originId','createdAt','updatedAt','expiresAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && friendOf(request.resource.data.to)
        && !exists(mutePath(request.resource.data.to, request.auth.uid))
        && request.resource.data.status == 'pending'
        && request.resource.data.targetKind in ['task','habit','reading','exercise','focus','general']
        && request.resource.data.targetText is string
        && request.resource.data.targetText.size() >= 2 && request.resource.data.targetText.size() <= 120
        && request.resource.data.targetValue is int
        && request.resource.data.targetValue >= 1 && request.resource.data.targetValue <= 1000000
        && request.resource.data.mode in ['now','online','inbox']
        && request.resource.data.attempt is int
        && request.resource.data.attempt >= 1 && request.resource.data.attempt <= 99
        && request.resource.data.originId is string
        && request.resource.data.originId.size() > 0 && request.resource.data.originId.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.mode == 'now'
            && request.resource.data.expiresAt > request.time + duration.value(25, 's')
            && request.resource.data.expiresAt <= request.time + duration.value(35, 's')
          ) ||
          (
            request.resource.data.mode == 'online'
            && request.resource.data.expiresAt > request.time + duration.value(23, 'h')
            && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
          ) ||
          (
            request.resource.data.mode == 'inbox'
            && request.resource.data.expiresAt == null
          )
        )
        && existsAfter(challengeRatePath(request.auth.uid))
        && getAfter(challengeRatePath(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(challengeRatePath(request.auth.uid)).data.lastAt == request.time
        && (
          !exists(challengeRatePath(request.auth.uid)) ||
          request.time >= get(challengeRatePath(request.auth.uid)).data.lastAt + duration.value(10, 's')
        );
      allow update: if signed()
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.targetKind == resource.data.targetKind
        && request.resource.data.targetText == resource.data.targetText
        && request.resource.data.targetValue == resource.data.targetValue
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.attempt == resource.data.attempt
        && request.resource.data.originId == resource.data.originId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.keys().hasOnly(['from','to','status','targetKind','targetText','targetValue','mode','attempt','originId','createdAt','updatedAt','expiresAt','respondedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt','updatedAt'])
        && request.resource.data.respondedAt == request.time
        && request.resource.data.updatedAt == request.time
        && resource.data.status == 'pending'
        && (
          (
            resource.data.to == request.auth.uid
            && !blockedBetween(resource.data.from, resource.data.to)
            && (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
            && request.resource.data.status in ['accepted','declined']
          ) ||
          (
            resource.data.from == request.auth.uid
            && request.resource.data.status == 'cancelled'
          )
        );
      allow delete: if false;

      match /quickMessages/{messageId} {
        allow get, list: if signed()
          && request.auth.uid in [get(/databases/$(database)/documents/challenges/$(challengeId)).data.from,get(/databases/$(database)/documents/challenges/$(challengeId)).data.to]
          && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status == 'accepted'
          && !blockedBetween(
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.from,
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.to
          );
        allow create: if signed()
          && request.auth.uid in [get(/databases/$(database)/documents/challenges/$(challengeId)).data.from,get(/databases/$(database)/documents/challenges/$(challengeId)).data.to]
          && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status == 'accepted'
          && !blockedBetween(
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.from,
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.to
          )
          && request.resource.data.keys().hasOnly(['uid','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text in ['بزن بریم 🔥','حواسم بهت هست 👀','ریز می‌بینمت 😎','کم نیار 👊','تا آخرش هستم 🤝','امروز مال ماست ⚡']
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signed() && resource.data.uid == request.auth.uid;
      }
    }

    match /activities/{activityId} {
      allow get, list: if signed() && (
        resource.data.uid == request.auth.uid ||
        (
          !blockedBetween(request.auth.uid, resource.data.uid) &&
          (
            resource.data.visibility == 'public' ||
            (resource.data.visibility == 'friends' && friendOf(resource.data.uid))
          )
        )
      );
      allow create: if signed() &&
        request.resource.data.uid == request.auth.uid &&
        activityId.matches('^[a-zA-Z0-9_-]{10,120}$') &&
        request.resource.data.keys().hasOnly([
          'uid','type','eventKey','visibility','category','createdAt',
          'pagesRead','percentAfter','bookTitle','excerpt','durationMin','tag'
        ]) &&
        request.resource.data.type in ['task','habit','goal','mission','reading','book','book_clip','exercise','focus','streak','ranking'] &&
        request.resource.data.visibility in ['friends','public'] &&
        request.resource.data.category in ['task','habit','goal','mission','reading','language','exercise','focus','streak','ranking'] &&
        request.resource.data.eventKey is string &&
        request.resource.data.eventKey.size() <= 120 &&
        request.resource.data.createdAt == request.time &&
        (
          (
            request.resource.data.type in ['task','habit','goal','mission','book','exercise','streak','ranking'] &&
            request.resource.data.keys().hasOnly(['uid','type','eventKey','visibility','category','createdAt'])
          ) ||
          (
            request.resource.data.type == 'reading' &&
            request.resource.data.keys().hasOnly(['uid','type','eventKey','visibility','category','createdAt','pagesRead','percentAfter','bookTitle']) &&
            request.resource.data.pagesRead is int &&
            request.resource.data.pagesRead >= 0 && request.resource.data.pagesRead <= 10000 &&
            request.resource.data.percentAfter is int &&
            request.resource.data.percentAfter >= 0 && request.resource.data.percentAfter <= 100 &&
            request.resource.data.bookTitle is string &&
            request.resource.data.bookTitle.size() <= 140
          ) ||
          (
            request.resource.data.type == 'book_clip' &&
            request.resource.data.keys().hasOnly(['uid','type','eventKey','visibility','category','createdAt','bookTitle','excerpt']) &&
            request.resource.data.bookTitle is string &&
            request.resource.data.bookTitle.size() <= 140 &&
            request.resource.data.excerpt is string &&
            request.resource.data.excerpt.size() <= 280
          ) ||
          (
            request.resource.data.type == 'focus' &&
            request.resource.data.keys().hasOnly(['uid','type','eventKey','visibility','category','createdAt','durationMin','tag']) &&
            request.resource.data.category == 'focus' &&
            request.resource.data.durationMin is int &&
            request.resource.data.durationMin >= 1 && request.resource.data.durationMin <= 180 &&
            request.resource.data.tag is string &&
            request.resource.data.tag.size() <= 60
          )
        );
      allow update: if false;
      allow delete: if signed() && resource.data.uid == request.auth.uid;

      match /likes/{likeId} {
        allow get, list: if canReadActivity(activityId);
        allow create: if canReadActivity(activityId)
          && likeId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signed() && resource.data.uid == request.auth.uid;
      }
      match /comments/{commentId} {
        allow get, list: if canReadActivity(activityId);
        allow create: if canReadActivity(activityId)
          && request.resource.data.keys().hasOnly(['uid','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signed() && (
          resource.data.uid == request.auth.uid ||
          get(activityPath(activityId)).data.uid == request.auth.uid
        );
      }
    }

    match /contentReports/{reportId} {
      allow get: if signed() && (resource.data.reporter == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['reporter','targetUid','kind','targetId','reason','detail','createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.kind in ['post','story']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 120
        && request.resource.data.reason in ['spam','harassment','hate','sexual','violence','privacy','other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 500
        && request.resource.data.createdAt == request.time
        && reportId == request.auth.uid + '__' + request.resource.data.kind + '__' + request.resource.data.targetId
        && (
          (
            request.resource.data.kind == 'post' &&
            canReadPost(request.resource.data.targetId) &&
            get(postPath(request.resource.data.targetId)).data.uid == request.resource.data.targetUid
          ) ||
          (
            request.resource.data.kind == 'story' &&
            canReadStory(request.resource.data.targetId) &&
            get(storyPath(request.resource.data.targetId)).data.uid == request.resource.data.targetUid
          )
        );
      allow update, delete: if false;
    }

    match /socialPosts/{postId} {
      allow get, list: if signed() && (
        resource.data.uid == request.auth.uid ||
        (
          !blockedBetween(request.auth.uid, resource.data.uid) &&
          (
            resource.data.visibility == 'public' ||
            (resource.data.visibility == 'friends' && friendOf(resource.data.uid))
          )
        )
      );

      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','text','visibility','createdAt','updatedAt','mediaPath','mediaType'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.visibility in ['private','friends','public']
        && (
          (
            !request.resource.data.keys().hasAny(['mediaPath','mediaType'])
            && request.resource.data.text.size() > 0
          ) ||
          (
            request.resource.data.keys().hasAll(['mediaPath','mediaType'])
            && request.resource.data.mediaType in ['image/jpeg','image/png','image/webp']
            && request.resource.data.mediaPath is string
            && request.resource.data.mediaPath.matches('^pageMedia/' + request.auth.uid + '/post/' + postId + '/[A-Za-z0-9_-]{8,100}[.](jpg|jpeg|png|webp)$')
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid','text','visibility','createdAt','updatedAt','mediaPath','mediaType'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.visibility in ['private','friends','public']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            !resource.data.keys().hasAny(['mediaPath','mediaType'])
            && !request.resource.data.keys().hasAny(['mediaPath','mediaType'])
            && request.resource.data.text.size() > 0
          ) ||
          (
            resource.data.keys().hasAll(['mediaPath','mediaType'])
            && request.resource.data.keys().hasAll(['mediaPath','mediaType'])
            && request.resource.data.mediaPath == resource.data.mediaPath
            && request.resource.data.mediaType == resource.data.mediaType
            && request.resource.data.mediaType in ['image/jpeg','image/png','image/webp']
            && request.resource.data.mediaPath.matches('^pageMedia/' + request.auth.uid + '/post/' + postId + '/[A-Za-z0-9_-]{8,100}[.](jpg|jpeg|png|webp)$')
          )
        );

      allow delete: if signed() && resource.data.uid == request.auth.uid;

      match /likes/{likeId} {
        allow get, list: if canReadPost(postId);
        allow create: if canReadPost(postId)
          && likeId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signed() && resource.data.uid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow get, list: if canReadPost(postId);
        allow create: if canReadPost(postId)
          && request.resource.data.keys().hasOnly(['uid','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signed() && (
          resource.data.uid == request.auth.uid ||
          get(postPath(postId)).data.uid == request.auth.uid
        );
      }
    }

    match /socialStories/{storyId} {
      allow get, list: if signed() && (
        resource.data.uid == request.auth.uid ||
        (
          !blockedBetween(request.auth.uid, resource.data.uid)
          && resource.data.expiresAt > request.time
          && (
            resource.data.visibility == 'public' ||
            (resource.data.visibility == 'friends' && friendOf(resource.data.uid))
          )
        )
      );

      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','text','visibility','createdAt','expiresAt','mediaPath','mediaType'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.visibility in ['private','friends','public']
        && (
          (
            !request.resource.data.keys().hasAny(['mediaPath','mediaType'])
            && request.resource.data.text.size() > 0
          ) ||
          (
            request.resource.data.keys().hasAll(['mediaPath','mediaType'])
            && request.resource.data.mediaType in ['image/jpeg','image/png','image/webp']
            && request.resource.data.mediaPath is string
            && request.resource.data.mediaPath.matches('^pageMedia/' + request.auth.uid + '/story/' + storyId + '/[A-Za-z0-9_-]{8,100}[.](jpg|jpeg|png|webp)$')
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');

      allow update: if false;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
