rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function mine(uid) { return signed() && request.auth.uid == uid; }
    function p(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function n(username) { return /databases/$(database)/documents/usernames/$(username); }
    function adminPath(uid) { return /databases/$(database)/documents/admins/$(uid); }
    function isAdmin() {
      return signed()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.enabled == true
        && get(adminPath(request.auth.uid)).data.role in ['owner','admin','moderator'];
    }
    function isOwner() {
      return signed()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.enabled == true
        && get(adminPath(request.auth.uid)).data.role == 'owner';
    }

    // Admin role records are bootstrapped only from Firebase Console/trusted backend.
    match /admins/{uid} {
      allow get: if mine(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /publicSettings/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['maintenanceEnabled','maintenanceMessage','updatedAt','updatedBy'])
        && request.resource.data.maintenanceEnabled is bool
        && request.resource.data.maintenanceMessage is string
        && request.resource.data.maintenanceMessage.size() <= 240
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isOwner();
    }

    match /adminSettings/{documentId} {
      allow read, create, update: if isAdmin();
      allow delete: if isOwner();
    }

    match /adminAudit/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','role','action','target','meta','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['owner','admin','moderator']
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 80
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 160;
      allow update, delete: if false;
    }

    // The username claim and matching user profile must be created atomically.
    match /usernames/{username} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed() && username.matches('^[a-z][a-z0-9_]{2,19}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(p(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow get: if signed();
      allow list: if isAdmin();
      allow create: if mine(uid)
        && request.resource.data.keys().hasOnly(['username','name','bio','xp'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z][a-z0-9_]{2,19}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.bio == '' && request.resource.data.xp == 0
        && getAfter(n(request.resource.data.username)).data.uid == uid;
      // Friendly beta XP is computed by the client, NOT tamper-proof.
      allow update: if mine(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','name','bio'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.xp <= 9999999
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 300;
      allow delete: if false;
    }

    // Admins do NOT receive blanket access to users' private app data.
    match /private/{uid}/app/{documentId} {
      allow read: if mine(uid) && documentId == 'main';
      allow create, update: if mine(uid) && documentId == 'main'
        && request.resource.data.keys().hasOnly(['payload','updatedAt'])
        && request.resource.data.payload is map;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get, list: if signed()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['from','to','status'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && exists(p(request.resource.data.to));
      allow update: if signed() && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if signed() && resource.data.from == request.auth.uid
        && resource.data.status == 'pending';
    }

    function requestPath(from, to) {
      return /databases/$(database)/documents/friendRequests/$(from + '_' + to);
    }
    function friendOf(owner) {
      return signed() && (
        (exists(requestPath(request.auth.uid, owner)) &&
         get(requestPath(request.auth.uid, owner)).data.status == 'accepted') ||
        (exists(requestPath(owner, request.auth.uid)) &&
         get(requestPath(owner, request.auth.uid)).data.status == 'accepted')
      );
    }

    match /activities/{activityId} {
      allow get, list: if signed() &&
        (resource.data.uid == request.auth.uid || friendOf(resource.data.uid));
      allow create: if signed() &&
        request.resource.data.keys().hasOnly(['uid','type','eventKey','createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        activityId.matches('^[a-zA-Z0-9_-]{10,120}$') &&
        request.resource.data.type in ['task','habit'] &&
        request.resource.data.eventKey is string &&
        request.resource.data.eventKey.size() <= 120 &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
